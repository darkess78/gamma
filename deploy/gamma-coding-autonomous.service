[Unit]
Description=Gamma owner-directed autonomous coding worker
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/gamma-main
ExecStart=%h/Documents/gamma-main/.venv/bin/python -m gamma.coding.autonomous
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
