{
  "name": "@gamma/minecraft-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Strict protocol and outbound control client for Gamma Minecraft companion v1",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist-test/test/*.test.js",
    "start": "npm run build && node dist-test/src/index.js"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "mineflayer": "4.37.1",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
